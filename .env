# ============================================
# PSAS PREVIEW SYSTEM - FIREBASE CONFIGURATION
# ============================================
# JANGAN SHARE FILE INI! Simpan rahasia.
# File ini hanya untuk Admin/Developer

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXX_YourActualAPIKey
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Optional: Measurement ID (tidak wajib)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# ============================================
# CATATAN:
# 1. Ganti semua value dengan data Firebase asli Anda
# 2. File ini wajib ditambahkan ke .gitignore
# 3. Untuk production, gunakan environment variables server
# ============================================